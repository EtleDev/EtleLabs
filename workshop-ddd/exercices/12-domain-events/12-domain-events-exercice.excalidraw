      "originalText": "class Trip extends AggregateRoot {\n  join(passengerId: string, tripId: string) { }\n  kickPassenger(passengerId: string) { }\n}\n\nclass JoinTrip {\n  async execute({ tripId, passengerId }) { }\n}\n\nclass NotificationService {\n  // Appelée quand un passager rejoint\n  notifyDriverForNewPassenger({\n    tripId,\n    passengerId\n  }) {\n    this.eventHandler.push(...)\n  }\n}\n\nclass UserBanned {\n  public readonly userId: string;\n}",
      "x": 892,
      "y": 46,
      "text": "class Trip extends AggregateRoot {\n  join(passengerId: string, tripId: string) { }\n  kickPassenger(passengerId: string) { }\n}\n\nclass JoinTrip {\n  async execute({ tripId, passengerId }) { }\n}\n\nclass NotificationService {\n  // Appelée quand un passager rejoint\n  notifyDriverForNewPassenger({\n    tripId,\n    passengerId\n  }) {\n    this.eventHandler.push(...)\n  }\n}\n\nclass UserBanned {\n  public readonly userId: string;\n}"
