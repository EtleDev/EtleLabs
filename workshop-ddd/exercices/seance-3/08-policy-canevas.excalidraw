      "originalText": "class Price {\n  private readonly value: number;\n}\n\nclass Journey {\n  calculatePrice(distance): Price {\n    return new Price(distance * 100);\n  }\n}",
      "x": 482,
      "y": 38,
      "text": "class Price {\n  private readonly value: number;\n}\n\nclass Journey {\n  calculatePrice(distance): Price {\n    return new Price(distance * 100);\n  }\n}"
    },
