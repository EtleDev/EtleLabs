      "originalText": "@Entity()\nclass Trip {\n  @Id() private id: string;\n  @Column() private seats: number;\n\n  // Les annotations de l'ORM vivent\n  // dans l'objet du domaine.\n  bookSeat() {\n    if (this.seats === 0) throw new TripFull();\n    this.seats--;\n  }\n}\n\nclass TripRepository {\n  save(trip: Trip) {\n    return this.orm.persist(trip);\n  }\n}",
      "x": 12,
      "y": 68,
      "text": "@Entity()\nclass Trip {\n  @Id() private id: string;\n  @Column() private seats: number;\n\n  // Les annotations de l'ORM vivent\n  // dans l'objet du domaine.\n  bookSeat() {\n    if (this.seats === 0) throw new TripFull();\n    this.seats--;\n  }\n}\n\nclass TripRepository {\n  save(trip: Trip) {\n    return this.orm.persist(trip);\n  }\n}"
    },
