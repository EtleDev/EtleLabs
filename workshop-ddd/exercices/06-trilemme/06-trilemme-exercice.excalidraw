      "groupIds": [],
      "frameId": null,
      "index": "a0011",
      "roundness": null,
      "seed": 1195443482,
      "version": 1,
      "versionNonce": 359944962,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793031755557,
      "link": null,
      "locked": true,
      "type": "text",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
