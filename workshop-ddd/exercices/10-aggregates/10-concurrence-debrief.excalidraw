      "originalText": "class AddNoteHandler {\n  execute(command) {\n    const journey =\n      this.journeys.byId(command.journeyId);\n\n    const note = journey.createNote({\n      tripId: command.tripId,\n      content: command.content,\n    });\n\n    this.notes.save(note);\n  }\n}\n\nclass FinishJourneyHandler {\n  execute(command) {\n    const journey =\n      this.journeys.byId(command.journeyId);\n\n    journey.finish();\n    this.journeys.save(journey);\n  }\n}",
      "x": 458,
      "y": 221,
      "text": "class AddNoteHandler {\n  execute(command) {\n    const journey =\n      this.journeys.byId(command.journeyId);\n\n    const note = journey.createNote({\n      tripId: command.tripId,\n      content: command.content,\n    });\n\n    this.notes.save(note);\n  }\n}\n\nclass FinishJourneyHandler {\n  execute(command) {\n    const journey =\n      this.journeys.byId(command.journeyId);\n\n    journey.finish();\n    this.journeys.save(journey);\n  }\n}"
    },
