      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "width": 323.4,
      "height": 165,
      "originalText": "class Journey {\n  calculatePrice(distance): Price {\n    let price = new Price(distance * 100);\n    if (distance > 50) {\n      price = price.discountedBy(10);\n    }\n    return price;\n  }\n}\n\n// Le « if » est honnête ici : une seule\n// règle, pas encore de variabilité.",
      "x": 900,
      "y": 248,
      "text": "class Journey {\n  calculatePrice(distance): Price {\n    let price = new Price(distance * 100);\n    if (distance > 50) {\n      price = price.discountedBy(10);\n    }\n    return price;\n  }\n}\n\n// Le « if » est honnête ici : une seule\n// règle, pas encore de variabilité."
    },
